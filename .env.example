# ============================================================
# wmm-client-reporting — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA commitear .env.local al repositorio.
# ============================================================

# ── Supabase (proyecto compartido WMM, prefijo cr_) ──────────
# https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=                  # server-side only — NUNCA prefijar con NEXT_PUBLIC_

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# ── Encriptación de credenciales (cr_channel_credentials) ────
# Clave AES de 32 bytes. Generar con: openssl rand -base64 32
CREDENTIALS_ENC_KEY=

# ── Meta Graph API v21.0 ─────────────────────────────────────
# Token a nivel agencia para la conexión global (caída por cliente).
# Tokens por cliente se almacenan cifrados en cr_channel_credentials.
META_APP_ID=
META_APP_SECRET=

# ── Google service account (GA4 + Search Console) ────────────
# Mismas credenciales para ambos. Scopes: analytics.readonly + webmasters.readonly
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=         # incluye \n literales para los saltos de línea

# ── TikTok Business API v1.3 ─────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Google Ads API (v17, OAuth2 refresh-token flow) ──────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
